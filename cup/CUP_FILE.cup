/*************/
/* IMPORT(S) */
/*************/
import java_cup.runtime.*;
import ast.*;

parser code 
{:
   public Lexer lexer;

   public Parser(Lexer lexer)
   {
      super(lexer);
      this.lexer = lexer;
   }

   // Override report_error to throw an exception instead of printing/exiting
   public void report_error(String message, Object info)
   {
      // We throw a RuntimeException with a specific prefix to identify it in Main
      // We use lexer.getLine() as the location
      throw new RuntimeException("SYNTAX_ERROR(" + lexer.getLine() + ")");
   }

   // Override report_fatal_error to ensure the same behavior
   public void report_fatal_error(String message, Object info)
   {
      report_error(message, info);
   }
:}

/************************/
/* CUSTOMIZE CUP PARSER */
/************************/
scan with
{:
   Symbol s;
   s = lexer.next_token();
   //System.out.print(s.sym);
   System.out.print("[");
   System.out.print(lexer.getLine());
   System.out.print(":");
   System.out.print(lexer.getTokenStartPosition());
   System.out.print("] ");
   System.out.print(TokenNames.terminalNames[s.sym]);
   if (s.value != null)
   {
      System.out.print("( ");
      System.out.print(s.value);
      System.out.print(" )");
   }
   System.out.print("\n");
   return s;
:};



/*************/
/* TERMINALS */
/*************/
terminal LPAREN;
terminal RPAREN;
terminal LBRACK;
terminal RBRACK;
terminal LBRACE;
terminal RBRACE;
terminal PLUS;
terminal MINUS;
terminal TIMES;
terminal DIVIDE;
terminal COMMA;
terminal DOT;
terminal SEMICOLON;
terminal TYPE_INT;
terminal TYPE_STRING;
terminal TYPE_VOID;
terminal ASSIGN;
terminal EQ;
terminal LT;
terminal GT;
terminal ARRAY;
terminal CLASS;
terminal RETURN;
terminal WHILE;
terminal IF;
terminal ELSE;
terminal NEW;
terminal EXTENDS;
terminal NIL;

/*************/
/* TERMINALS */
/*************/
terminal Integer INT;
terminal String STRING;
terminal String ID;

/*****************/
/* NON TERMINALS */
/*****************/
non terminal AstProgram program;
non terminal AstDec dec;
non terminal AstType type;
non terminal AstVarDec varDec;
non terminal AstFuncDec funcDec;
non terminal AstStmtList stmtList;
non terminal AstClassDec classDec;
non terminal AstDec cField;
non terminal AstArrayTypedef arrayTypedef;
non terminal AstExp exp;
non terminal AstNewExp newExp;
non terminal AstCallExp callExp;
non terminal AstVar var;
non terminal AstStmt stmt;

/* We added these non terminals: */

non terminal AstParam param;
non terminal AstParamList paramList;
non terminal AstDecList cFieldList;
non terminal AstExpList expList;


/***********************/
/* OPERATOR PRECEDENCE */
/***********************/
precedence nonassoc ASSIGN;     // :=
precedence left EQ;               // =
precedence left LT, GT;           // <, >
precedence left PLUS, MINUS;      // +, -
precedence left TIMES, DIVIDE; // *, /
precedence nonassoc LBRACK;    // [
precedence nonassoc LPAREN;    // (
precedence left DOT;           // .

/************************/
/* START WITH: stmtList */
/************************/
start with program;

/********************/
/* DERIVATION RULES */
/********************/


program       ::=    dec:d               {: RESULT = new AstDecList(d, null, dleft+1); :}
                 | dec:d program:l       {: RESULT = new AstDecList(d, l, dleft+1);    :}
                 ;



dec       ::=    varDec:d                {: RESULT = d;     :}
               | funcDec:d               {: RESULT = d;     :}
               | classDec:d              {: RESULT = d;     :}
               | arrayTypedef:d          {: RESULT = d;     :}
               ;


type      ::=    TYPE_INT:t              {: RESULT = new AstType("int", tleft+1);       :}
               | TYPE_STRING:t           {: RESULT = new AstType("string", tleft+1);    :}
               | TYPE_VOID:t             {: RESULT = new AstType("void", tleft+1);      :}
               | ID:typeName             {: RESULT = new AstType(typeName, typeNameleft+1); :}
               ;


varDec        ::=    type:t ID:name SEMICOLON                   {: RESULT = new AstVarDec(t, name, null, tleft+1);  :}
               | type:t ID:name ASSIGN exp:e SEMICOLON          {: RESULT = new AstVarDec(t, name, e, tleft+1);     :}
               | type:t ID:name ASSIGN newExp:e SEMICOLON       {: RESULT = new AstVarDec(t, name, e, tleft+1);     :}
               ;


param     ::=    type:t ID:name          {: RESULT = new AstParam(t, name, tleft+1); :}
                    ;

paramList  ::=   param:p                 {: RESULT = new AstParamList(p, null, pleft+1); :}
               | param:p COMMA paramList:l  {: RESULT = new AstParamList(p, l, pleft+1);     :}
               ;


funcDec    ::=    type:t ID:name LPAREN RPAREN LBRACE stmtList:body RBRACE               {: RESULT = new AstFuncDec(t, name, null, body, tleft+1);   :}
               | type:t ID:name LPAREN paramList:l RPAREN LBRACE stmtList:body RBRACE    {: RESULT = new AstFuncDec(t, name, l, body, tleft+1);      :}
               ;


cField    ::=    varDec:d           {: RESULT = d; :}
               | funcDec:d          {: RESULT = d; :}
               ;

cFieldList     ::=    cField:d                  {: RESULT = new AstDecList(d, null, dleft+1);   :}
               | cField:d cFieldList:l          {: RESULT = new AstDecList(d, l, dleft+1);  :}
               ;


classDec   ::=    CLASS:c ID:name LBRACE cFieldList:body RBRACE                   {: RESULT = new AstClassDec(name, null, body, cleft+1);    :}
               | CLASS:c ID:name EXTENDS ID:parent LBRACE cFieldList:body RBRACE    {: RESULT = new AstClassDec(name, parent, body, cleft+1);   :}
               ;


arrayTypedef ::=   ARRAY:a ID:typeName EQ type:t LBRACK RBRACK SEMICOLON       {: RESULT = new AstArrayTypedef(typeName, t, aleft+1);  :}
               ;


exp          ::=       INT:i                       {: RESULT = new AstExpInt(i, ileft+1);        :}
               | MINUS:m INT:i                     {: RESULT = new AstExpInt(-i, mleft+1);       :}
               | STRING:s                          {: RESULT = new AstExpString(s, sleft+1);      :}
               | NIL:n                             {: RESULT = new AstExpNil(nleft+1);         :}
               | var:v                             {: RESULT = new AstExpVar(v, vleft+1);              :}
               | exp:e1 PLUS  exp:e2               {: RESULT = new AstExpBinop(e1, e2, 0, e1left+1);    :}
               | exp:e1 MINUS exp:e2               {: RESULT = new AstExpBinop(e1, e2, 1, e1left+1);    :}
               | exp:e1 TIMES exp:e2               {: RESULT = new AstExpBinop(e1, e2, 2, e1left+1);    :}
               | exp:e1 DIVIDE exp:e2              {: RESULT = new AstExpBinop(e1, e2, 3, e1left+1);    :}
               | exp:e1 LT exp:e2                  {: RESULT = new AstExpBinop(e1, e2, 4, e1left+1);    :}
               | exp:e1 GT exp:e2                  {: RESULT = new AstExpBinop(e1, e2, 5, e1left+1);    :}
               | exp:e1 EQ exp:e2                  {: RESULT = new AstExpBinop(e1, e2, 6, e1left+1);    :}
               | LPAREN exp:e RPAREN               {: RESULT = e;                   :}
               | callExp:e                         {: RESULT = e;                   :}
               ;


newExp    ::=    NEW:n type:t                         {: RESULT = new AstNewExp(t, null, nleft+1);    :}
               | NEW:n type:t LBRACK exp:e RBRACK     {: RESULT = new AstNewExp(t, e, nleft+1);   :}
               ;


expList       ::=       exp:e                 {: RESULT = new AstExpList(e, null, eleft+1);   :}
               | exp:e COMMA expList:l        {: RESULT = new AstExpList(e, l, eleft+1);     :}
               ;

callExp    ::=    var:v DOT ID:name LPAREN expList:l RPAREN     {: RESULT = new AstCallExp(v, name, l, vleft+1);          :}
               | var:v DOT ID:name LPAREN RPAREN                {: RESULT = new AstCallExp(v, name, null, vleft+1);    :}
               | ID:name LPAREN expList:l RPAREN                {: RESULT = new AstCallExp(null, name, l, nameleft+1);    :}
               | ID:name LPAREN RPAREN                          {: RESULT = new AstCallExp(null, name, null, nameleft+1);  :}
               ;


var          ::=       ID:name                          {: RESULT = new AstVarSimple(name, nameleft+1);       :}
               | var:v DOT ID:fieldName                 {: RESULT = new AstVarField(v, fieldName, vleft+1); :}
               | var:v LBRACK exp:e RBRACK              {: RESULT = new AstVarSubscript(v, e, vleft+1);     :}
               ;


stmt      ::=       var:v ASSIGN exp:e SEMICOLON                                 {: RESULT = new AstStmtAssign(v, e, vleft+1);   :}
               | var:v ASSIGN newExp:e SEMICOLON                                 {: RESULT = new AstStmtAssign(v, e, vleft+1);   :}
               | IF:i LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE         {: RESULT = new AstStmtIf(cond, body, ileft+1);  :}
               | IF:i LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE ELSE LBRACE stmtList:elsebody RBRACE   {: RESULT = new AstStmtIfElse(cond, body, elsebody, ileft+1);:}
               | WHILE:w LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE      {: RESULT = new AstStmtWhile(cond, body, wleft+1);:}
               | varDec:d                                                        {: RESULT = new AstStmtDec(d, dleft+1);       :}
               | RETURN:r exp:e SEMICOLON                                        {: RESULT = new AstStmtReturn(e, rleft+1);     :}
               | RETURN:r SEMICOLON                                              {: RESULT = new AstStmtReturn(null, rleft+1);   :}
               | callExp:e SEMICOLON                                             {: RESULT = new AstStmtCall(e, eleft+1);          :}
               ;

stmtList   ::=       stmt:s stmtList:l     {: RESULT = new AstStmtList(s, l, sleft+1);    :}
               | stmt:s                    {: RESULT = new AstStmtList(s, null, sleft+1); :}
               ;